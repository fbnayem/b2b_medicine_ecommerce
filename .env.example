# API Settings
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/medsupply_b2b?replicaSet=rs0

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
# Both secrets must be at least 32 characters, and production refuses to start
# with the example values below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development_only_jwt_secret_at_least_32_characters
# ^ this exact value is refused when NODE_ENV=production
# Optional. When unset the refresh secret is derived from JWT_SECRET, which is
# how every deployment before Phase 12 worked. Setting it separately means a
# leaked access-token secret cannot also be used to mint refresh tokens.
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Mail (Mailpit Local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@medsupply.local

# Object Storage (MinIO Local)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=root
S3_SECRET_KEY=password
S3_BUCKET_NAME=medsupply-assets

# Configurable invoice identity (overridden by system settings in Phase 10)
BUSINESS_NAME=MedSupply B2B
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
INVOICE_FOOTER=
INVOICE_TAX_BASIS_POINTS=0

# Delivery proof policy (comma-separated: OTP,SIGNATURE,PHOTOGRAPH,GPS)
DELIVERY_REQUIRED_PROOFS=OTP

# Phase 8 finance controls
DELIVERY_COLLECTION_REQUIRES_VERIFICATION=true
CUSTOMER_ADVANCE_ENABLED=true
CREDIT_BLOCK_ON_LIMIT_EXCEEDED=true
CREDIT_BLOCK_OVERDUE_THRESHOLD_MINOR=0
CREDIT_OVERDUE_GRACE_DAYS=0

# Phase 9 notifications, real-time updates and activity
# REDIS_URL takes precedence over REDIS_HOST/REDIS_PORT above. When neither is
# reachable the API falls back to an in-process queue and a single-instance
# Socket.IO server; nothing is dropped, but it stops being horizontally scalable.
REDIS_URL=
REDIS_PASSWORD=
# Comma-separated Socket.IO and REST allow-list.
CORS_ORIGINS=http://localhost:5173,exp://localhost:8081
# Outbound channel providers. Each unset webhook falls back to a logging adapter
# so the message is still produced and observable in development.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_TOKEN=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=
# Expo push. The default endpoint needs no credential; the access token is only
# required when the Expo project enables enhanced push security.
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
# Near-expiry digest window in days (1-365). Defaults to 90 until Phase 10
# moves this into persisted system settings.
NEAR_EXPIRY_DAYS=90

# Phase 10 system settings
# Everything below is a FALLBACK. Once an administrator saves a settings group
# in the web application, the persisted values win and these are only used if
# that group is reset. Precedence is persisted -> environment -> built-in default,
# applied per field. Infrastructure configuration above (database, Redis, JWT,
# CORS, provider webhooks) is deliberately NOT editable through the application.
BUSINESS_LEGAL_NAME=
BUSINESS_LOGO_URL=
BUSINESS_WEBSITE=
BUSINESS_TRADE_LICENCE=
BUSINESS_DRUG_LICENCE=
DEFAULT_PAYMENT_TERMS_DAYS=30
LOW_STOCK_THRESHOLD=10
DELIVERY_OTP_EXPIRY_MINUTES=10
NOTIFICATION_QUIET_HOURS_ENABLED=false
NOTIFICATION_QUIET_HOURS_START=22:00
NOTIFICATION_QUIET_HOURS_END=07:00
OVERDUE_DIGEST_ENABLED=true
NEAR_EXPIRY_DIGEST_ENABLED=true
# Time zone used by notification quiet hours and digest day boundaries.
PRIMARY_TIMEZONE=Asia/Dhaka
PRIMARY_LOCALE=en
PRIMARY_DATE_FORMAT=DD MMM YYYY
PRIMARY_CURRENCY=BDT
PRIMARY_CURRENCY_SYMBOL=৳
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
FORCE_PASSWORD_CHANGE_ON_CREATE=true

# ─── Phase 12 security, performance and release readiness ────────────────────

# Number of reverse proxies in front of the API. Rate limiting and audit records
# are only as trustworthy as req.ip, and req.ip is only trustworthy when Express
# is told exactly how many hops to skip. Zero means the API is addressed
# directly and X-Forwarded-For is ignored; set it to 1 behind a single nginx or
# load balancer. Setting it too high lets a caller forge their own address.
TRUST_PROXY_HOPS=0

# Request body ceilings. Delivery proof and payment attachments are base64
# inside JSON and are capped at 2 MB decoded by their own validators, so the
# delivery and payment routers use the upload limit and everything else the
# smaller one.
JSON_BODY_LIMIT=256kb
UPLOAD_BODY_LIMIT=4mb

# Rate limiting. Each tier is a separate budget within one window, so a burst of
# writes cannot lock a user out of signing in. Authenticated callers are keyed
# by user; anonymous ones by address. With REDIS_URL set the budget is shared
# across instances; without it each instance keeps its own.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_REPORT_MAX=60

# Database. The pool bounds how many operations one instance may have in flight.
# The query timeout is a server-side ceiling on a single aggregation, which is
# what keeps one very wide report from occupying a database thread indefinitely.
DB_MAX_POOL_SIZE=20
DB_QUERY_TIMEOUT_MS=20000

# Build identity, reported by /health/version and stamped on every log line.
APP_VERSION=1.0.0
GIT_COMMIT=unknown
# debug | info | warn | error | silent
LOG_LEVEL=info

# ─── Web application build ───────────────────────────────────────────────────
# Compiled into the bundle at build time, not read at runtime. The default is a
# same-origin relative path, which is what keeps the SameSite=Strict refresh
# cookie working; set an absolute URL only when the API is on another origin,
# and add that origin to CORS_ORIGINS above.
VITE_API_URL=/api/v1

# ─── Mobile application ──────────────────────────────────────────────────────
# Expo inlines statically referenced EXPO_PUBLIC_* values at build time.
EXPO_PUBLIC_API_URL=
