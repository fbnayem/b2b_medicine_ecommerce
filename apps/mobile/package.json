{
  "name": "@medsupply/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@medsupply/api-client": "workspace:^",
    "@medsupply/design-tokens": "workspace:^",
    "@medsupply/i18n": "workspace:^",
    "@medsupply/jurisdictions": "workspace:^",
    "@medsupply/navigation": "workspace:^",
    "@medsupply/shared-types": "workspace:^",
    "@medsupply/utilities": "workspace:^",
    "@medsupply/validation": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.18.1",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "lint": "oxlint app src",
    "pretypecheck": "pnpm --filter @medsupply/jurisdictions build && pnpm --filter @medsupply/shared-types build && pnpm --filter @medsupply/utilities build && pnpm --filter @medsupply/validation build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @medsupply/jurisdictions build && pnpm --filter @medsupply/shared-types build && pnpm --filter @medsupply/utilities build && pnpm --filter @medsupply/validation build",
    "test": "vitest run --configLoader runner",
    "prestart": "pnpm --filter @medsupply/jurisdictions build && pnpm --filter @medsupply/shared-types build && pnpm --filter @medsupply/utilities build && pnpm --filter @medsupply/validation build",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
